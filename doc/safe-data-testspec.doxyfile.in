# Doxygen template — Safe Data API test specification (XML + HTML).
# Configured by doc/CMakeLists.txt; @DOC_BASE@ / @DOXY_OUT@ are substituted.
#
# The PREDEFINED expansions turn the ztest macros into doxygen-visible
# entities: every ZTEST_SUITE() defines a doxygen group named after the ztest
# suite, every ZTEST() function joins that group. The group hierarchy above
# the suites (all_tests / safe_data_tests / safe_data_module) lives in
# _doxygen/safe-data-test-groups.dox and the annotations in the test sources.

PROJECT_NAME           = "Safe Data API Test Specification"
PROJECT_BRIEF          = "Annotated ztest sources of the Safe Data API"
PROJECT_NUMBER         = 0.2

OUTPUT_DIRECTORY       = @DOXY_OUT@
CREATE_SUBDIRS         = NO

INPUT                  = @DOC_BASE@/_doxygen/mainpage-safe-data-testspec.md \
                         @DOC_BASE@/_doxygen/safe-data-test-groups.dox \
                         @DOC_BASE@/../tests/safe_data/src/main.c
USE_MDFILE_AS_MAINPAGE = @DOC_BASE@/_doxygen/mainpage-safe-data-testspec.md
RECURSIVE              = NO

JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
EXCLUDE_SYMBOLS        = _* z_* Z_*
SORT_MEMBER_DOCS       = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO

# Test-annotation vocabulary (subset of the zephyr-safety conventions):
#   @testid{ID}      stable test-case ID    -> xrefsect "testids"
#   @reqref{REQ-ID}  verified requirement   -> xrefsect "reqrefs"
#   @draft/@active/@obsolete  test status   -> xrefsect "test_<status>"
ALIASES                = "testid{1}=\xrefitem testids \"Test ID\" \"Test IDs\" \1" \
                         "reqref{1}=\xrefitem reqrefs \"Requirement\" \"Requirements\" \1" \
                         "draft=\qualifier draft^^\xrefitem test_draft \"Test Status: Draft\" \"Draft Test Cases\"" \
                         "active=\qualifier active^^\xrefitem test_active \"Test Status: Active\" \"Active Test Cases\"" \
                         "obsolete=\qualifier obsolete^^\xrefitem test_obsolete \"Test Status: Obsolete\" \"Obsolete Test Cases\""

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = NO
PREDEFINED             = __DOXYGEN__ \
                         "ZTEST(suite, fn)=/** \ingroup suite */ void fn(void)" \
                         "ZTEST_USER(suite, fn)=/** \ingroup suite */ void fn(void)" \
                         "ZTEST_F(suite, fn)=/** \ingroup suite */ void fn(void)" \
                         "ZTEST_USER_F(suite, fn)=/** \ingroup suite */ void fn(void)" \
                         "ZTEST_SUITE(suite, u1, u2, u3, u4, u5)=/** \defgroup suite suite */"
SKIP_FUNCTION_MACROS   = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
GENERATE_LATEX         = NO

GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = NO
